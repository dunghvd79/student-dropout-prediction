# Sao chép file này thành .env rồi đổi mật khẩu. KHÔNG commit file .env.

# MinIO (Raw Data Lake + kho artifact của MLflow)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# PostgreSQL – cổng 5433 vì 5432 thường đã bị PostgreSQL khác trên máy chiếm
# PostgreSQL (students, financial_profiles, predictions, ingestion_log + backend store của MLflow)
POSTGRES_USER=ews
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=dropout_ews
POSTGRES_PORT=5433

# MongoDB (collection academic_semesters)
# Cổng 27018 để tránh trùng với MongoDB cài sẵn trên máy (27017)
MONGO_USER=ews
MONGO_PASSWORD=change_me_mongo
MONGO_DB=dropout_ews
MONGO_PORT=27018

# MLflow Tracking Server
MLFLOW_PORT=5000
